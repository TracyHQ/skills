{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "gitUrl": {
      "type": "string",
      "format": "uri"
    },
    "ref": {
      "default": "main",
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9._\\-\\/]+$"
    },
    "skillPath": {
      "type": "string",
      "minLength": 1
    },
    "autoInstall": {
      "default": false,
      "type": "boolean"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90
    },
    "runMinutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 120
    },
    "platforms": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wordpress",
          "woocommerce",
          "joomla",
          "shopify"
        ]
      }
    },
    "extensions": {
      "description": "Extension keys that bind this skill to a site by what it runs (ADR 0075 amendment): the skill reaches a site whose surface inventory answers to ANY listed key, with the platforms filter still applying on top. An inventory item answers to its id, its name, and its attributes.template / attributes.module values; list whichever of those is stable for the platform (WordPress: the id slug; Joomla: the manifest name or template directory name). Matching is exact full-string, never a substring.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    }
  },
  "required": [
    "namespace",
    "slug",
    "gitUrl",
    "skillPath"
  ]
}
