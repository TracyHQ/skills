    "validate": "tsx bin/validate.ts",
    "build-index": "tsx bin/build-index.ts",
    "emit-schema": "tsx bin/emit-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.engine.json",
    "check-scripts": "node scripts/check-scripts.mjs",
